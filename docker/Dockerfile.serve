FROM python:3.11-slim

WORKDIR /app

# Only inference dependencies - no training-only libraries (no tensorboard,
# no pyyaml needed here since serve.py doesn't read training_config.yaml).
COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

COPY src/model.py src/serve.py ./src/

# --- Run as non-root user (assignment requirement) ---
RUN groupadd --system appgroup && useradd --system --gid appgroup appuser \
    && chown -R appuser:appgroup /app
USER appuser

ENV PYTHONUNBUFFERED=1
EXPOSE 8080

# Kubernetes has its own liveness/readiness probes (Part E), but this
# HEALTHCHECK also makes `docker ps` / plain `docker run` self-reporting.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')" || exit 1

CMD ["python", "src/serve.py"]